# Copy to .env and fill in. Never commit .env.

# Postgres. Locally: postgres://localhost:5432/persuna. On Railway this is set
# from the Postgres service automatically.
DATABASE_URL=postgres://localhost:5432/persuna

# Accounts (Better Auth). Generate a secret with: openssl rand -base64 32
# Required in production.
# BETTER_AUTH_SECRET=
# Comma-separated emails or @domains. ADMIN_EMAILS can see everything and the
# Models & keys page. AUTH_ALLOWED_EMAILS limits sign-ups (empty = open).
# ADMIN_EMAILS=you@example.com
# AUTH_ALLOWED_EMAILS=@yourdomain.com

# "mock" runs offline stand-in models so the whole app works without keys.
# Defaults to mock when EXTRACT_API_KEY is empty, live otherwise.
# MODEL_PROVIDER=mock

# Values starting with PASTE_ / REPLACE_ / YOUR_ etc. count as unset, so you can
# leave visible slots such as EXTRACT_API_KEY=PASTE_META_API_KEY_HERE.

# Model roles. Each points at an OpenAI-compatible chat-completions endpoint
# (the base URL is the part before /chat/completions). DRAFT_* and EVAL_* fall
# back to EXTRACT_* when unset, so one provider is enough to start.

# Extract rules and turn corrections into rule changes (Muse Spark, Meta Model API)
EXTRACT_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_MODEL=

# Draft outputs (Muse Spark Open on Baseten)
# DRAFT_BASE_URL=
# DRAFT_API_KEY=
# DRAFT_MODEL=

# For "thinking" models (for example Muse Spark Open 1026 on Baseten): how hard
# to think before answering, sent as reasoning_effort: none, low, medium, high
# or max (Meta's muse-spark-1.3 takes max; a model that refuses a value is asked
# again without it).
# Leave unset for models that don't take it. Applies to that role's own provider.
# DRAFT_REASONING_EFFORT=low
# EVAL_REASONING_EFFORT=low
# Another model on the same provider, used if the main one answers "not found"
# (Meta's muse-spark-1.3 sometimes does). For example:
# EXTRACT_FALLBACK_MODEL=muse-spark-1.2

# Score drafts against held-back examples (Muse Spark Open on Modal or Baseten)
# EVAL_BASE_URL=
# EVAL_API_KEY=
# EVAL_MODEL=

# Speech to text for voice walkthroughs and voice-note jobs (Muse Voice Transcribe).
# OpenAI-compatible POST {base}/audio/transcriptions. Falls back to EXTRACT_*.
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=
# Which transcription API shape to use: "meta" (Muse Voice Transcribe's native
# /asr/transcribe) or "openai" (/audio/transcriptions). Default: meta when the
# base URL is api.meta.ai, otherwise openai.
# TRANSCRIBE_API=

# Persuna's voice (text to speech). Without a key, the browser's own voice is used.
# OpenAI-compatible POST {base}/audio/speech by default (base https://api.openai.com/v1,
# model gpt-4o-mini-tts, voice nova), or ElevenLabs with SPEECH_API=elevenlabs
# (voice is an ElevenLabs voice id; model eleven_flash_v2_5).
# SPEECH_API=
# SPEECH_BASE_URL=
# SPEECH_API_KEY=
# SPEECH_MODEL=
# SPEECH_VOICE=

# How Persuna hears you when you talk to it:
#   listen     - the recording goes straight to the LISTEN model (Muse Spark hears
#                audio), which writes down what you said and answers in one call.
#   transcribe - transcribe first (TRANSCRIBE_*), then answer.
#   agent      - ElevenLabs Agents listens, knows when you've finished, lets you
#                interrupt and speaks; Persuna's server (Muse Spark) still thinks.
#                Run `npm run voice:agent` once to create the agent.
# Default: agent when ELEVENLABS_AGENT_ID is set, otherwise listen.
# VOICE_MODE=
# The listening model. Falls back to EXTRACT_*; reasoning defaults to "minimal".
# LISTEN_MODEL=muse-spark-1.3
# LISTEN_REASONING_EFFORT=minimal
# Finding things on screen when Persuna points at something its list of the
# screen doesn't name: SAM 3.1 on Meta's /v1/responses, with EXTRACT_*'s key.
# SAM_MODEL=sam-3.1   (or "off")

# ElevenLabs Agents (uses SPEECH_API_KEY). The secret is any long random string;
# ElevenLabs sends it when it calls {APP_URL}/api/persuna/llm.
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_LLM_SECRET=

# Connected apps: Persuna can search and draft email, read and add calendar
# events, and find and add Notion pages, asking before anything is sent or
# created. CONNECTIONS_KEY (any long random string) encrypts the tokens.
# Google: a Google Cloud OAuth client (Web application) with the Gmail and
# Calendar APIs enabled; redirect URI {APP_URL}/api/connections/google/callback.
# Notion: a public integration; redirect URI {APP_URL}/api/connections/notion/callback.
# CONNECTIONS_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Payments, in US dollars. "mock" records payments without moving money.
# "paystack" collects real payments in USD (enable USD on your Paystack
# account): use a test secret key (sk_test_...) until you go live, and set
# the webhook URL in the Paystack dashboard to {APP_URL}/api/webhooks/paystack.
# PAYMENTS_PROVIDER=mock
# PAYSTACK_SECRET_KEY=
# Public URL of this app, for Paystack callbacks and employer approval links.
# APP_URL=http://localhost:3000

# Persuna as an MCP server: public URL of the MCP Worker in
# cloudflare/mcp-worker, once deployed (npx wrangler deploy there). When
# set, Skills → Import shows per-platform MCP connect instructions
# (Claude Code, Claude Desktop, Cursor) with this address filled in.
# MCP_SERVER_URL=https://persuna-mcp.<your-account>.workers.dev/mcp

# Trust ladder thresholds (defaults shown)
# TRUST_L1_MIN_JOBS=20
# TRUST_L1_MIN_CLEAN_PERCENT=90
# TRUST_L2_MIN_JOBS=50
# TRUST_SPOT_CHECK_EVERY=5

# Business rules (defaults shown)
# JOB_RETENTION_DAYS=30
# PLATFORM_FEE_PERCENT=20
# LISTING_MIN_SCORE=80

# Live model calls each signed-in user may make per 24 hours (admins exempt)
# DAILY_MODEL_CALLS_PER_USER=150

# Optional tuning
# MODEL_CONCURRENCY=5
# MODEL_TIMEOUT_MS=180000
