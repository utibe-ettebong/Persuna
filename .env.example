# Copy to .env and fill in. Never commit .env.

# Postgres. Locally: postgres://localhost:5432/persuna. On Railway this is set
# from the Postgres service automatically.
DATABASE_URL=postgres://localhost:5432/persuna

# Accounts (Better Auth). Generate a secret with: openssl rand -base64 32
# Required in production.
# BETTER_AUTH_SECRET=
# Comma-separated emails or @domains. ADMIN_EMAILS can see everything and the
# Models & keys page. AUTH_ALLOWED_EMAILS limits sign-ups (empty = open).
# ADMIN_EMAILS=you@example.com
# AUTH_ALLOWED_EMAILS=@yourdomain.com

# "mock" runs offline stand-in models so the whole app works without keys.
# Defaults to mock when EXTRACT_API_KEY is empty, live otherwise.
# MODEL_PROVIDER=mock

# Values starting with PASTE_ / REPLACE_ / YOUR_ etc. count as unset, so you can
# leave visible slots such as EXTRACT_API_KEY=PASTE_META_API_KEY_HERE.

# Model roles. Each points at an OpenAI-compatible chat-completions endpoint
# (the base URL is the part before /chat/completions). DRAFT_* and EVAL_* fall
# back to EXTRACT_* when unset, so one provider is enough to start.

# Extract rules and turn corrections into rule changes (Muse Spark, Meta Model API)
EXTRACT_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_MODEL=

# Draft outputs (Muse Spark Open on Baseten)
# DRAFT_BASE_URL=
# DRAFT_API_KEY=
# DRAFT_MODEL=

# Score drafts against held-back examples (Muse Spark Open on Modal)
# EVAL_BASE_URL=
# EVAL_API_KEY=
# EVAL_MODEL=

# Speech to text for voice walkthroughs and voice-note jobs (Muse Voice Transcribe).
# OpenAI-compatible POST {base}/audio/transcriptions. Falls back to EXTRACT_*.
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=

# Payments. "mock" records payments without moving money. "paystack" collects
# real payments: use a test secret key (sk_test_...) until you go live, and set
# the webhook URL in the Paystack dashboard to {APP_URL}/api/webhooks/paystack.
# PAYMENTS_PROVIDER=mock
# PAYSTACK_SECRET_KEY=
# Public URL of this app, for Paystack callbacks and employer approval links.
# APP_URL=http://localhost:3000

# Trust ladder thresholds (defaults shown)
# TRUST_L1_MIN_JOBS=20
# TRUST_L1_MIN_CLEAN_PERCENT=90
# TRUST_L2_MIN_JOBS=50
# TRUST_SPOT_CHECK_EVERY=5

# Business rules (defaults shown)
# JOB_RETENTION_DAYS=30
# PLATFORM_FEE_PERCENT=20
# LISTING_MIN_SCORE=80

# Live model calls each signed-in user may make per 24 hours (admins exempt)
# DAILY_MODEL_CALLS_PER_USER=150

# Optional tuning
# MODEL_CONCURRENCY=5
# MODEL_TIMEOUT_MS=180000
