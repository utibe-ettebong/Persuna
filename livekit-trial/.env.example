# LiveKit Cloud project (https://cloud.livekit.io). Inference bills to this account.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The Persuna app under test, and who the trial acts as.
PERSUNA_APP_URL=http://localhost:3000
PERSUNA_USER_EMAIL=hello@example.com

# Shared secret for /api/persuna/livekit-tool; must match the app's LIVEKIT_TOOL_SECRET.
LIVEKIT_TOOL_SECRET=

# realtime (Gemini Live via LiveKit Inference) or pipeline (STT-LLM-TTS via Inference).
TRIAL_ENGINE=realtime
