{
  "name": "persuna",
  "version": "0.1.0",
  "private": true,
  "description": "PERSUNA: train a personal AI agent on how you work, from before-and-after examples.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "skill": "tsx --env-file-if-exists=.env scripts/skill.ts",
    "demo:seed": "tsx --env-file-if-exists=.env scripts/demo-seed.ts"
  },
  "dependencies": {
    "diff": "9.0.0",
    "docx": "^9.14.0",
    "drizzle-orm": "0.45.4",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prettier": "3.9.10",
    "railway": "3.16.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
