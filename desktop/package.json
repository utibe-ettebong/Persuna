{
  "name": "persuna-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Persuna, your AI assistant, over your whole screen.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --arm64 --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "author": {
    "name": "Persuna",
    "email": "hello@gamaidfoundation.org"
  },
  "homepage": "https://persuna-production.up.railway.app",
  "build": {
    "appId": "app.persuna.persona",
    "productName": "Persuna",
    "copyright": "\u00a9 Persuna. MIT licensed.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup-preload.js",
      "hold-key.js",
      "package.json",
      "build/tray*.png",
      "!node_modules/uiohook-napi/prebuilds/linux-*",
      "!node_modules/uiohook-napi/src/**",
      "!node_modules/uiohook-napi/libuiohook/**"
    ],
    "artifactName": "Persuna-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Persuna listens when you talk to it."
      }
    },
    "dmg": {
      "title": "Persuna ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Persuna"
    },
    "protocols": [
      {
        "name": "Persuna",
        "schemes": [
          "persuna"
        ]
      }
    ]
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  }
}
